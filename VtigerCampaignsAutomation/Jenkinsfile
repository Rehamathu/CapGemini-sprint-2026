pipeline {
    agent any

    tools {
        jdk 'JDK'
        maven 'Maven3'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Run Tests') {
            steps {
                dir('VtigerCampaignsAutomation') {
                    bat 'mvn clean test'
                }
            }
        }
    }

    post {
        always {
            junit allowEmptyResults: true,
                  testResults: 'VtigerCampaignsAutomation/target/surefire-reports/*.xml'
        }
    }
}
