pipeline {
    agent any

    tools {
        jdk 'JDK'
        maven 'Maven3'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Verify Project') {
            steps {
                dir('VtigerCampaignsAutomation') {
                    bat 'dir'
                    bat 'mvn -version'
                    bat 'if not exist pom.xml exit /b 1'
                }
            }
        }

        stage('Run Tests') {
            steps {
                dir('VtigerCampaignsAutomation') {
                    bat 'mvn clean test'
                }
            }
        }
    }

    post {
        always {
            junit allowEmptyResults: true,
                  testResults: 'VtigerCampaignsAutomation/target/surefire-reports/*.xml'

            archiveArtifacts artifacts:
                'VtigerCampaignsAutomation/target/surefire-reports/**, VtigerCampaignsAutomation/screenshots/**',
                allowEmptyArchive: true
        }
    }
}
