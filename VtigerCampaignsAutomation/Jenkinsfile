
pipeline {
    agent any

    tools {
        jdk 'JDK'
        maven 'Maven3'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Run Tests') {
            steps {
                bat 'mvn clean test'
            }
        }
    }

    post {
        always {
            junit allowEmptyResults: true,
                  testResults: '**/target/surefire-reports/*.xml'
        }

        success {
            echo 'Automation tests completed successfully.'
        }

        failure {
            echo 'Build failed. Check Console Output for the error.'
        }
    }
}
