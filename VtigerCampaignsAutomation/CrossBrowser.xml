<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Cross Browser Testing" preserve-order="true">

    <!-- Chrome -->
    <test name="Chrome Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="Campaigns.crud.CampaignPersistenceTest"/>
            <class name="Campaigns.crud.CreateCampaignTest"/>
            <class name="Campaigns.crud.ViewCampaignTest"/>
            <class name="Campaigns.crud.EditCampaignTest"/>
