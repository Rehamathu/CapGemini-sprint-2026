            <class name="Campaigns.dropdowns.CampaignTypeTest"/>
            <class name="Campaigns.dropdowns.ExpectedResponseDropdownTest"/>

            <class name="Campaigns.search.SearchCampaignTest"/>
            <class name="Campaigns.search.AdvancedSearchTest"/>
            <class name="Campaigns.search.CampaignAlphabeticalNavigationTest"/>
            <class name="Campaigns.search.CustomViewTest"/>

            <class name="Campaigns.smoke.CampaignNavigationTest"/>
            <class name="Campaigns.smoke.CampaignsPageTest"/>

            <class name="Campaigns.validation.CampaignDateValidationTest"/>
            <class name="Campaigns.validation.MandatoryFieldsTest"/>

            <class name="Leads.LeadsNavigationTest"/>
            <class name="Leads.LeadsPageTest"/>

            <class name="Dashboard.DashboardNavigationTest"/>
            <class name="Dashboard.DashboardWidgetsTest"/>
        </classes>
    </test>

