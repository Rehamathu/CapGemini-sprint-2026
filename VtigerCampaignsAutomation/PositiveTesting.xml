<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Positive Testing" preserve-order="true">

    <test name="CRM Positive Tests">
        <groups>
            <run>
                <include name="Positive"/>
            </run>
        </groups>

        <classes>
            <!-- Campaign CRUD -->
            <class name="Campaigns.crud.CampaignPersistenceTest"/>
            <class name="Campaigns.crud.CreateCampaignTest"/>
            <class name="Campaigns.crud.ViewCampaignTest"/>
            <class name="Campaigns.crud.EditCampaignTest"/>
            <class name="Campaigns.crud.DuplicateCampaignTest"/>
            <class name="Campaigns.crud.DeleteCampaignTest"/>

            <!-- Campaign dropdowns -->
            <class name="Campaigns.dropdowns.AssignedToDropdownTest"/>
            <class name="Campaigns.dropdowns.CampaignStatusTest"/>
            <class name="Campaigns.dropdowns.CampaignTypeTest"/>
            <class name="Campaigns.dropdowns.ExpectedResponseDropdownTest"/>

            <!-- Campaign search -->
            <class name="Campaigns.search.SearchCampaignTest"/>
            <class name="Campaigns.search.AdvancedSearchTest"/>
            <class name="Campaigns.search.CampaignAlphabeticalNavigationTest"/>
            <class name="Campaigns.search.CustomViewTest"/>

            <!-- Navigation -->
            <class name="Campaigns.smoke.CampaignNavigationTest"/>
            <class name="Campaigns.smoke.CampaignsPageTest"/>
            <class name="Leads.LeadsNavigationTest"/>
            <class name="Leads.LeadsPageTest"/>
            <class name="Dashboard.DashboardNavigationTest"/>
            <class name="Dashboard.DashboardWidgetsTest"/>
        </classes>
    </test>

</suite>
